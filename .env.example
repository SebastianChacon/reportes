# Where the office's copy of each report is filed (Convex).
#
# Created by running `npx convex dev` once, with your own Convex account — it
# writes CONVEX_DEPLOYMENT to .env.local and prints the URL to put here.
#
# Without it the app is unchanged: reports go out through the share sheet as
# they do today and nothing is filed. The phone keeps every sent report in its
# history, so the first reconnect after this is set backfills them.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-123.convex.cloud

# Email delivery (Resend — https://resend.com)
# Without these three the app still works: "Send report" returns 503 and the
# foreman falls back to "Download PDF".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where the office receives reports. Comma-separated for several recipients.
REPORT_TO_EMAIL=Esantander@backtonature.net

# Must be an address on a domain you have added AND verified at
# https://resend.com/domains — Resend rejects anything else with a 403, which is
# why a placeholder here makes every send fail. Reserved TLDs (.example, .test,
# .invalid) can never be verified, so the API route rejects them up front with a
# readable error instead of an opaque 502.
REPORT_FROM_EMAIL=reports@backtonature.net
