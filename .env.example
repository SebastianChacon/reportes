# Where the office's copy of each report is filed (Convex).
#
# Created by running `npx convex dev` once, with your own Convex account — it
# writes CONVEX_DEPLOYMENT to .env.local and prints the URL to put here.
#
# Without it the app is unchanged: reports go out through the share sheet as
# they do today and nothing is filed. The phone keeps every sent report in its
# history, so the first reconnect after this is set backfills them.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-123.convex.cloud

# Signs the httpOnly cookie that says which foreman is holding the phone. That
# cookie is the only thing that can set `reports.submittedBy`, which is what lets
# the office ask "who did not send a report today".
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Without it — or with anything under 32 characters, which is refused rather than
# accepted quietly — the app never asks who the foreman is and files reports
# unattributed, exactly as it did before. Nothing breaks; the office just cannot
# tell whose report is whose.
AUTH_SECRET=

# Where the console lives, for the link the report email carries back to it.
#
# Optional. Without it the link is built from the origin the phone posted from,
# which is right in development and on the real domain. Set it in production
# anyway: on a preview deployment that origin is a hostname that stops existing
# in a week, and this link goes into a mailbox to be clicked next month.
#
# The link is omitted entirely when NEXT_PUBLIC_CONVEX_URL is unset — nothing is
# filed without a deployment, so there would be no report to open.
APP_URL=https://reportes.backtonature.net

# Fills the office sign-in form with the demonstration account, so showing the
# console is one click instead of typing a password in front of an audience.
#
# Set it to exactly `1` to switch on. Anything else, including leaving it unset,
# prefills nothing — and unset is the right answer for any deployment with real
# reports in it.
#
# It offers ONLY the demo account created by `npx convex run seed:demo`
# (demo@backtonature.test), whose password is a literal in lib/demoAccount.ts and
# has therefore been public since the seed existed. The real office password is
# not offered here and cannot be: to appear in the field it would have to be sent
# to the browser, and anything the browser is given is public. That would not be
# a weaker door, it would be no door.
#
# Note the absent NEXT_PUBLIC_ prefix, which is load-bearing. That prefix inlines
# a value into the browser bundle; this is read by a server component instead, so
# a deployment without the variable ships no password at all rather than an
# unused one. Verified by building without it and grepping .next/static.
#
# Requires the demo account to exist on the deployment this points at, or the
# button answers "wrong password" with the fields already full — which is the
# most confusing way this can fail. Run `npx convex run seed:demo` first.
DEMO_SIGN_IN=

# Email delivery (Resend — https://resend.com)
# Without these three the app still works: "Send report" returns 503 and the
# foreman falls back to "Download PDF".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where the office receives reports. Comma-separated for several recipients.
REPORT_TO_EMAIL=Esantander@backtonature.net

# Must be an address on a domain you have added AND verified at
# https://resend.com/domains — Resend rejects anything else with a 403, which is
# why a placeholder here makes every send fail. Reserved TLDs (.example, .test,
# .invalid) can never be verified, so the API route rejects them up front with a
# readable error instead of an opaque 502.
REPORT_FROM_EMAIL=reports@backtonature.net
